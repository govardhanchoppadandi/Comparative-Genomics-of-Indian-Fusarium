cat("\nPNG:  ",PNG_FILE,"\n",sep="")
cat("PDF:  ",PDF_FILE,"\n",sep="")
cat("TIFF: ",TIFF_FILE,"\n",sep="")
cat("DATA: ",DATA_FILE,"\n",sep="")
cat("\nNote: exported data retain NA; missing plotting measurements are shown as empty-length bars.\n")
