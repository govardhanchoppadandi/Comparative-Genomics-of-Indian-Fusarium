R8 <- P8 + PANEL_WIDTH


# ================================================================================
# 38. INTERNAL CAFE LABELS
# ================================================================================

internal_nodes <-
  (
    NTIP + 1
  ):NTOTAL

internal_nodes <-
  internal_nodes[
    vapply(
      internal_nodes,
      function(node) {

        !is.null(
          get_cafe(node)
        )

      },
      logical(1)
    )
  ]

INTERNAL_RADIUS <- 0.0085

internal_x <-
  tree_x[
    internal_nodes
  ]

internal_y <-
  tree_y_scaled[
    internal_nodes
  ]


# ----------------------------------------------------------------
# KEEP CAFE VALUES CLOSE TO THEIR PIE
# BUT DO NOT TOUCH PIE OR OTHER VALUES
# ----------------------------------------------------------------

label_x <-
  pmin(
    internal_x +
      INTERNAL_RADIUS +
      0.006,
    INTERNAL_VALUE_X -
      0.006
  )

label_y <-
  internal_y


ord <- order(
  label_y
)

MIN_GAP <- 0.017

if (length(ord) > 1) {

  for (
    k in 2:length(ord)
  ) {

    a <- ord[k - 1]
    b <- ord[k]

    if (
      label_y[b] -
        label_y[a]
      <
      MIN_GAP
    ) {

      label_y[b] <-
        label_y[a] +
        MIN_GAP

    }

  }

}

label_y <-
  pmin(
    label_y,
    0.905
  )

label_y <-
  pmax(
    label_y,
    0.075
  )


# ================================================================================
