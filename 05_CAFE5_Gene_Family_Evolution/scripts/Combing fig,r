# ---- 4. HELPERS ---------------------------------------------------------------
normalize_genome <- function(x) {
  x <- tolower(trimws(as.character(x)))

  # Remove common file extensions first.
  x <- gsub("\\.(fa|fasta|faa|fna|gz|xlsx|csv)$", "", x, ignore.case=TRUE)

  # Treat DMW8_draft_genome as the same genome as DMW8.
  x <- gsub("_draft_genome$", "", x, ignore.case=TRUE)

  # Treat protein-suffixed IDs as their base genome IDs.
  x <- gsub("_proteins?$", "", x, ignore.case=TRUE)

  # Ignore punctuation, spaces, underscores, and hyphens.
  gsub("[^a-z0-9]", "", x)
}

# Confirm known ID variants normalize to the same key.
stopifnot(
  normalize_genome("DMW8") == normalize_genome("DMW8_draft_genome"),
  normalize_genome("TNW1") == normalize_genome("TNW1_proteins"),
  normalize_genome("TNW1") == normalize_genome("TNW_1")
)
clean_genome <- function(x) gsub("\\s+", "", trimws(as.character(x)))

find_column <- function(df, exact=NULL, patterns=NULL) {
  nms <- names(df)
  if (!is.null(exact)) {
    hit <- exact[exact %in% nms]
    if (length(hit)) return(hit[1])
  }
  if (!is.null(patterns)) for (p in patterns) {
    hit <- grep(p, nms, ignore.case=TRUE, value=TRUE)
    if (length(hit)) return(hit[1])
  }
  NULL
}
read_excel_first_matching_sheet <- function(path, preferred=NULL, required=NULL) {
  sheets <- readxl::excel_sheets(path)
  if (!is.null(preferred) && preferred %in% sheets) {
    x <- as.data.frame(readxl::read_excel(path, sheet=preferred), check.names=FALSE)
    if (is.null(required) || all(required %in% names(x))) return(x)
  }
  for (s in sheets) {
    x <- tryCatch(as.data.frame(readxl::read_excel(path, sheet=s), check.names=FALSE),
                  error=function(e) NULL)
    if (!is.null(x) && (is.null(required) || all(required %in% names(x)))) {
      message("Using sheet '", s, "' from ", basename(path))
      return(x)
    }
  }
  stop("Could not find a suitable sheet in ", path,
       if (!is.null(required)) paste0("\nRequired columns: ", paste(required, collapse=", ")))
}
check_duplicates <- function(df, label) {
  if (any(is.na(df$Key) | df$Key == "")) stop("Blank genome ID in ", label)
  d <- unique(df$Key[duplicated(df$Key)])
  if (length(d)) stop("Duplicate normalized genome IDs in ", label, ": ",
                      paste(d, collapse=", "))
}
match_features <- function(master, source, columns, label) {
  idx <- match(master$Key, source$Key)
  if (anyNA(idx)) stop("Missing genomes in ", label, ": ",
                       paste(master$Genome[is.na(idx)], collapse=", "))
  out <- source[idx, columns, drop=FALSE]
  rownames(out) <- NULL
  out
}
as_num <- function(x) suppressWarnings(as.numeric(as.character(x)))

# ---- 5. READ AND VALIDATE TREE ------------------------------------------------
if (!file.exists(TREE_FILE)) stop("Tree file not found: ", TREE_FILE)
tr <- ape::read.tree(TREE_FILE)
if (ape::Ntip(tr) != 36) stop("Tree must contain exactly 36 tips; found ", ape::Ntip(tr))
tree_names <- clean_genome(sub("<[0-9]+>$", "", tr$tip.label))
tree_keys <- normalize_genome(tree_names)
master_keys <- normalize_genome(master_order)
if (anyDuplicated(tree_keys)) stop("Duplicate normalized IDs in tree labels.")
if (length(setdiff(master_keys, tree_keys)) || length(setdiff(tree_keys, master_keys))) {
  stop("Tree labels do not match master_order after normalization.\\nMissing from tree: ",
       paste(setdiff(master_keys, tree_keys), collapse=", "),
       "\\nExtra in tree: ", paste(setdiff(tree_keys, master_keys), collapse=", "))
}

# Keep the input phylogeny unchanged. Category rows will follow the actual
# plotted tip coordinates calculated below, not Excel row order or raw Newick text order.

# ---- 6. READ CAFE5 ------------------------------------------------------------
if (!file.exists(CAFE_FILE)) stop("CAFE file not found: ", CAFE_FILE)
cafe <- read.delim(CAFE_FILE, header=TRUE, sep="\t", stringsAsFactors=FALSE,
                   check.names=FALSE, comment.char="")
names(cafe) <- trimws(names(cafe))
names(cafe)[1] <- "Taxon_ID"
if (!all(c("Taxon_ID", "Increase", "Decrease") %in% names(cafe))) {
  stop("CAFE file requires Taxon_ID, Increase, and Decrease columns.")
}
cafe$CAFE_ID <- suppressWarnings(as.integer(sub(".*<([0-9]+)>.*", "\\1", cafe$Taxon_ID)))
direct_id <- suppressWarnings(as.integer(as.character(cafe$Taxon_ID)))
ii <- is.na(cafe$CAFE_ID) & !is.na(direct_id)
cafe$CAFE_ID[ii] <- direct_id[ii]
cafe$Increase <- as_num(cafe$Increase); cafe$Decrease <- as_num(cafe$Decrease)
if (anyNA(cafe$CAFE_ID) || anyNA(cafe$Increase) || anyNA(cafe$Decrease))
  stop("Missing/non-numeric CAFE IDs or Increase/Decrease values.")
NTIP <- ape::Ntip(tr); NTOTAL <- NTIP + tr$Nnode
if (any(cafe$CAFE_ID < 1 | cafe$CAFE_ID > NTOTAL)) stop("CAFE ID outside tree node range.")
if (anyDuplicated(cafe$CAFE_ID)) stop("Duplicate CAFE IDs in Base_clade_results.txt.")
cafe_map <- vector("list", NTOTAL)
for (i in seq_len(nrow(cafe))) cafe_map[[cafe$CAFE_ID[i]]] <- cafe[i,,drop=FALSE]
get_cafe <- function(node) cafe_map[[node]]
format_change <- function(z) paste0("+", format(z$Increase, big.mark=",",
  scientific=FALSE, trim=TRUE), " / -", format(z$Decrease, big.mark=",",
  scientific=FALSE, trim=TRUE))

# ---- 7. READ TE/RIP EXCEL -----------------------------------------------------
if (!file.exists(TE_RIP_FILE)) stop("TE/RIP file not found: ", TE_RIP_FILE)
te <- as.data.frame(readxl::read_excel(TE_RIP_FILE), check.names=FALSE)
genome_col_te <- find_column(te, exact=c("Genome","Species"),
                             patterns=c("^genome$","^species$"))
genome_size_col <- find_column(te, exact="Genome_size_Mb",
                               patterns=c("genome.*size.*mb","genome.*size","assembly.*size"))
te_col <- find_column(te, exact="TE_percent_genome",
                      patterns=c("^TE_percent","TE.*percent.*genome","TE.*content"))
rip_col <- find_column(te, exact="RIP_percent_genome",
                       patterns=c("^RIP_percent","RIP.*percent.*genome","RIP.*content"))
lrar_col <- find_column(te, exact="LRAR_percent_genome",
                        patterns=c("LRAR.*percent.*genome","LRAR.*percent","LRAR.*content"))
overlap_col <- find_column(te, exact="LRAR_with_TE_overlap_percent",
                           patterns=c("LRAR.*TE.*overlap.*percent","TE.*RIP.*overlap.*percent",
                                      "RIP.*TE.*overlap.*percent","TE_RIP_overlap"))
te_cols <- list(Genome=genome_col_te, Genome_size=genome_size_col, TE=te_col,
                RIP=rip_col, LRAR=lrar_col, Overlap=overlap_col)
if (any(vapply(te_cols, is.null, logical(1)))) {
  stop("Could not identify TE/RIP columns. Available columns: ", paste(names(te), collapse=", "))
}
te_clean <- data.frame(
  Genome=clean_genome(te[[genome_col_te]]),
  Key=normalize_genome(te[[genome_col_te]]),
  Genome_size_Mb=as_num(te[[genome_size_col]]),
  TE=as_num(te[[te_col]]), RIP=as_num(te[[rip_col]]),
  LRAR=as_num(te[[lrar_col]]), TE_RIP_overlap=as_num(te[[overlap_col]]),
  check.names=FALSE
)

