  master,
  match_features(master, te_clean,
    c("Genome_size_Mb","TE","RIP","LRAR","TE_RIP_overlap"), "TE/RIP"),
  match_features(master, antismash_clean,
    c("Total_BGC","NRPS","PKS","Hybrid","Terpene","Other_BGC"), "antiSMASH"),
  match_features(master, dbcan_clean, c("GH","GT","CE","PL","AA","CBM"), "dbCAN3")
)
rownames(dat) <- NULL
stopifnot(nrow(dat)==36, identical(dat$Genome, master_order), identical(dat$Key, master_keys))

# Missing numeric measurements are reported and are NOT silently replaced by zero.
numeric_columns <- c("Genome_size_Mb","TE","RIP","LRAR","TE_RIP_overlap",
                     "Total_BGC","NRPS","PKS","Hybrid","Terpene","Other_BGC",
                     "GH","GT","CE","PL","AA","CBM")
cat("\nMISSING-VALUE REPORT (NA values remain NA):\n")
for (cc in numeric_columns) {
  miss <- which(!is.finite(dat[[cc]]))
  if (length(miss)) cat(cc, ": ", paste(dat$Genome[miss], collapse=", "), "\n", sep="")
}
tnw1_row <- which(dat$Key == normalize_genome("TNW1"))
if (length(tnw1_row) != 1) stop("TNW1 did not resolve to exactly one row.")
cat("\nTNW1 data check:\n")
print(dat[tnw1_row, , drop=FALSE])
write.csv(dat, DATA_FILE, row.names=FALSE, na="NA")

# For plotting only, NA feature values are treated as zero-length bars.
# The exported CSV retains NA so missing values are distinguishable from true zeros.
plot_dat <- dat
for (cc in numeric_columns) {
  plot_dat[[cc]][!is.finite(plot_dat[[cc]])] <- 0
}

# ---- 11. TREE COORDINATES -----------------------------------------------------
tmp_pdf <- tempfile(fileext=".pdf")
grDevices::pdf(tmp_pdf, width=10, height=12)
plot.phylo(tr, type="phylogram", direction="rightwards", use.edge.length=TRUE,
           show.tip.label=FALSE, show.node.label=FALSE, no.margin=TRUE)
coord <- get("last_plot.phylo", envir=ape:::.PlotPhyloEnv)
grDevices::dev.off()
unlink(tmp_pdf)
xx <- coord$xx; yy <- coord$yy
raw_min <- min(yy[seq_len(NTIP)]); raw_max <- max(yy[seq_len(NTIP)])
if (raw_max == raw_min) stop("Tree tip coordinates have zero range.")
tree_y_scaled <- 0.090 + ((yy-raw_min)/(raw_max-raw_min))*0.810
xn <- (xx-min(xx))/(max(xx)-min(xx))
tree_x <- 0.025 + (xn^1.45)*0.235
master_tree_y <- vapply(
  master_keys,
  function(k) tree_y_scaled[match(k, tree_keys)],
  numeric(1)
)
N <- length(master_order)

# ---- ONE SHARED TOP-TO-BOTTOM ORDER FOR ALL PANELS -----------------------------
# The phylogeny determines the visible row order. Each input was already matched
# by normalized genome ID; now apply one common tree-derived order to names,
# all feature rows, category matrices, and y-coordinates.
tree_plot_order <- order(master_tree_y, decreasing = TRUE)

master_order <- master_order[tree_plot_order]
master_keys <- master_keys[tree_plot_order]
dat <- dat[tree_plot_order, , drop = FALSE]
plot_dat <- plot_dat[tree_plot_order, , drop = FALSE]
master_tree_y <- master_tree_y[tree_plot_order]

rownames(dat) <- NULL
rownames(plot_dat) <- NULL

# Save the CSV in the same top-to-bottom order used for the figure.
write.csv(dat, DATA_FILE, row.names = FALSE, na = "NA")
tnw1_row <- which(dat$Key == normalize_genome("TNW1"))

# Hard checks: all labels and all eight category panels share row identity.
stopifnot(
  length(master_order) == 36,
  length(master_keys) == 36,
  nrow(dat) == 36,
  nrow(plot_dat) == 36,
  identical(dat$Genome, master_order),
  identical(dat$Key, master_keys),
  all(diff(master_tree_y) < 0),
  length(tnw1_row) == 1
)

cat("\nFINAL DISPLAY ORDER — ACTUAL TREE, TOP TO BOTTOM:\n")
print(data.frame(
  Position = seq_len(N),
  Genome = master_order,
  Tree_Y = master_tree_y
), row.names = FALSE)

# ---- 12. DRAWING HELPERS ------------------------------------------------------
draw_pie <- function(x,y,expansion,contraction,radius=0.009) {
  total <- expansion+contraction
  if (!is.finite(total) || total<=0) return(invisible(NULL))
  prop <- expansion/total
  th1 <- seq(0,2*pi*prop,length.out=80)
  polygon(c(x,x+radius*cos(th1)),c(y,y+radius*sin(th1)),
          col=EXPANSION,border="white",lwd=.5)
  th2 <- seq(2*pi*prop,2*pi,length.out=80)
  polygon(c(x,x+radius*cos(th2)),c(y,y+radius*sin(th2)),
          col=CONTRACTION,border="white",lwd=.5)
  th <- seq(0,2*pi,length.out=80)
  lines(x+radius*cos(th),y+radius*sin(th),col="white",lwd=.6)
}
draw_feature_bar <- function(value,x_left,x_right,y,height,fill,max_value) {
  rect(x_left,y-height/2,x_right,y+height/2,col="#EEEEEE",border=NA)
  if (is.finite(value) && value>0 && max_value>0) {
    vx <- x_left+(value/max_value)*(x_right-x_left)
    rect(x_left,y-height/2,vx,y+height/2,col=fill,border=NA)
  }
}
draw_stacked_bar <- function(values,colors,x_left,x_right,y,height,max_total) {
  rect(x_left,y-height/2,x_right,y+height/2,col="#EEEEEE",border=NA)
  values[!is.finite(values) | values<0] <- 0
  if (sum(values)<=0 || max_total<=0) return(invisible(NULL))
  xpos <- x_left
  for (i in seq_along(values)) {
    if (values[i]<=0) next
    xnext <- xpos+(values[i]/max_total)*(x_right-x_left)
    rect(xpos,y-height/2,xnext,y+height/2,col=colors[i],border=NA)
    xpos <- xnext
  }
}
draw_ticks <- function(max_value,x_left,x_right,y_axis,percent=FALSE) {
  if (!is.finite(max_value) || max_value<=0) return(invisible(NULL))
  ticks <- pretty(c(0,max_value),n=3)
  ticks <- ticks[ticks>=0 & ticks<=max_value]
  for (v in ticks) {
    xpos <- x_left+(v/max_value)*(x_right-x_left)
    segments(xpos,y_axis,xpos,y_axis-.008,col="#444444",lwd=.7)
    lab <- if (percent) paste0(format(v,trim=TRUE),"%") else
      format(v,trim=TRUE,big.mark=",",scientific=FALSE)
    text(xpos,y_axis-.017,lab,cex=CE_AXIS,font=2,col=TEXTCOL)
  }
}

# All eight panels below use plot_dat AFTER the shared tree-order sort.\n# ---- 13. PANEL POSITIONS / SCALE MAXIMA ---------------------------------------
TREE_LEFT <- .020; TREE_RIGHT <- .245
INTERNAL_VALUE_X <- .265; TIP_PIE_X <- .300; TIP_VALUE_X <- .323
NAME_LEFT <- .365
PANEL_START <- .535; PANEL_WIDTH <- .047; PANEL_GAP <- .008
P <- PANEL_START + (0:7)*(PANEL_WIDTH+PANEL_GAP)
R <- P+PANEL_WIDTH

safe_max <- function(x, multiplier=1.10) {
  z <- x[is.finite(x)]
  if (!length(z) || max(z)<=0) 1 else max(z)*multiplier
}
max_genome <- safe_max(plot_dat$Genome_size_Mb)
max_te <- safe_max(plot_dat$TE); max_rip <- safe_max(plot_dat$RIP)
max_lrar <- safe_max(plot_dat$LRAR); max_overlap <- safe_max(plot_dat$TE_RIP_overlap)
max_bgc <- safe_max(plot_dat$Total_BGC)
anti_matrix <- as.matrix(plot_dat[,c("NRPS","PKS","Hybrid","Terpene","Other_BGC")])
dbcan_matrix <- as.matrix(plot_dat[,c("GH","GT","CE","PL","AA","CBM")])
anti_max <- safe_max(rowSums(anti_matrix,na.rm=TRUE))
dbcan_max <- safe_max(rowSums(dbcan_matrix,na.rm=TRUE))

# ---- 14. PLOT FUNCTION --------------------------------------------------------
plot_integrated_figure <- function() {
  plot(NA,NA,type="n",xlim=c(0,1),ylim=c(0,1),axes=FALSE,xlab="",ylab="")

  # Tree horizontal branches
  for (i in seq_len(nrow(tr$edge))) {
    parent <- tr$edge[i,1]; child <- tr$edge[i,2]
    segments(tree_x[parent],tree_y_scaled[child],tree_x[child],tree_y_scaled[child],
             col=TREECOL,lwd=1.15)
  }
  # Tree vertical branches
  for (p in unique(tr$edge[,1])) {
    children <- tr$edge[tr$edge[,1]==p,2]
    if (length(children)>=2)
      segments(tree_x[p],min(tree_y_scaled[children]),tree_x[p],
               max(tree_y_scaled[children]),col=TREECOL,lwd=1.15)
  }

  internal_nodes <- (NTIP+1):NTOTAL
  internal_nodes <- internal_nodes[vapply(internal_nodes,function(n) !is.null(get_cafe(n)),logical(1))]
  ir <- .0085
  ix <- tree_x[internal_nodes]; iy <- tree_y_scaled[internal_nodes]
  lx <- pmin(ix+ir+.006,INTERNAL_VALUE_X-.006); ly <- iy
  ord <- order(ly); min_gap <- .017
  if (length(ord)>1) for (k in 2:length(ord)) {
    a <- ord[k-1]; b <- ord[k]
    if (ly[b]-ly[a]<min_gap) ly[b] <- ly[a]+min_gap
  }
  ly <- pmax(.075,pmin(ly,.905))
  for (n in internal_nodes) {
    z <- get_cafe(n)
    draw_pie(tree_x[n],tree_y_scaled[n],z$Increase,z$Decrease,radius=ir)
  }
  for (i in seq_along(internal_nodes)) {
    segments(ix[i]+ir,iy[i],lx[i]-.004,ly[i],col=LEADERCOL,lwd=.45)
    text(lx[i],ly[i],format_change(get_cafe(internal_nodes[i])),
         adj=c(0,.5),cex=CE_INTERNAL_VALUE,font=2,col=TEXTCOL)
  }

  text(TIP_PIE_X,.952,"CAFE5",font=2,cex=CE_HEADER,col=TEXTCOL)
  text(TIP_VALUE_X,.952,"Expansion / Contraction",font=2,cex=.52,
       adj=c(0,.5),col=TEXTCOL)
  text(NAME_LEFT,.952,"Fusarium genome",font=2,cex=CE_HEADER,
       adj=c(0,.5),col=TEXTCOL)

  # Tips are always drawn in master_order, mapped to tree tip IDs by normalized key.
  for (i in seq_len(N)) {
    tree_tip <- match(master_keys[i],tree_keys)
    z <- get_cafe(tree_tip)
    if (!is.null(z)) {
      draw_pie(TIP_PIE_X,master_tree_y[i],z$Increase,z$Decrease,radius=.010)
      text(TIP_VALUE_X,master_tree_y[i],format_change(z),adj=c(0,.5),
           cex=CE_CAFE_VALUE,font=2,col=TEXTCOL)
    }
    text(NAME_LEFT,master_tree_y[i],master_order[i],adj=c(0,.5),
         font=2,cex=CE_GENOME,col=TEXTCOL)
  }

  title_y <- .952
  panel_title <- function(x,label,cex=CE_PANEL_TITLE)
    text(x,title_y,label,font=2,cex=cex,col=TEXTCOL)
  panel_title(mean(c(P[1],R[1])),"Genome\nsize")
  panel_title(mean(c(P[2],R[2])),"TE")
  panel_title(mean(c(P[3],R[3])),"RIP")
  panel_title(mean(c(P[4],R[4])),"LRAR")
  panel_title(mean(c(P[5],R[5])),"TE–RIP")
  panel_title(mean(c(P[6],R[6])),"BGC")
  panel_title(mean(c(P[7],R[7])),"antiSMASH")
  panel_title(mean(c(P[8],R[8])),"dbCAN3")

  bh <- .011
  for (i in seq_len(N)) {
    y <- master_tree_y[i]
    draw_feature_bar(plot_dat$Genome_size_Mb[i],P[1],R[1],y,bh,COL_GENOME,max_genome)
    draw_feature_bar(plot_dat$TE[i],P[2],R[2],y,bh,COL_TE,max_te)
    draw_feature_bar(plot_dat$RIP[i],P[3],R[3],y,bh,COL_RIP,max_rip)
    draw_feature_bar(plot_dat$LRAR[i],P[4],R[4],y,bh,COL_LRAR,max_lrar)
    draw_feature_bar(plot_dat$TE_RIP_overlap[i],P[5],R[5],y,bh,COL_OVERLAP,max_overlap)
    draw_feature_bar(plot_dat$Total_BGC[i],P[6],R[6],y,bh,COL_BGC,max_bgc)
    draw_stacked_bar(as.numeric(anti_matrix[i,]),ANTISMASH_COLORS,P[7],R[7],y,bh,anti_max)
    draw_stacked_bar(as.numeric(dbcan_matrix[i,]),DBCAN_COLORS,P[8],R[8],y,bh,dbcan_max)
  }

  axis_y <- .050
  draw_ticks(max_genome,P[1],R[1],axis_y,FALSE)
  draw_ticks(max_te,P[2],R[2],axis_y,TRUE)
  draw_ticks(max_rip,P[3],R[3],axis_y,TRUE)
  draw_ticks(max_lrar,P[4],R[4],axis_y,TRUE)
  draw_ticks(max_overlap,P[5],R[5],axis_y,TRUE)
  draw_ticks(max_bgc,P[6],R[6],axis_y,FALSE)
  draw_ticks(anti_max,P[7],R[7],axis_y,FALSE)
  draw_ticks(dbcan_max,P[8],R[8],axis_y,FALSE)

  legend("topleft",inset=c(.005,.005),legend=c("Expansion","Contraction"),
         pch=15,col=c(EXPANSION,CONTRACTION),pt.cex=1,bty="n",
         cex=CE_LEGEND,text.font=2,horiz=TRUE,x.intersp=.5)
  legend("bottom",inset=c(0,-.055),legend=c("NRPS","PKS","Hybrid","TER","Other"),
         fill=ANTISMASH_COLORS,border=NA,bty="n",horiz=TRUE,
         cex=CE_LEGEND,text.font=2,x.intersp=.40)
  legend("bottom",inset=c(0,-.092),legend=c("GH","GT","CE","PL","AA","CBM"),
         fill=DBCAN_COLORS,border=NA,bty="n",horiz=TRUE,
         cex=CE_LEGEND,text.font=2,x.intersp=.35)
  text(.020,.012,
       "CAFE5: gene-family expansion/contraction; bars: genome-level features; stacked bars: antiSMASH BGC and dbCAN3 CAZyme composition.",
       adj=c(0,.5),cex=CE_FOOT,font=1,col="#555555")
}

# ---- 15. EXPORT PNG / PDF / TIFF ----------------------------------------------
grDevices::png(PNG_FILE,width=10000,height=6000,res=600,type="cairo")
par(mar=c(1,1,1,1),xpd=TRUE,family="sans")
plot_integrated_figure()
grDevices::dev.off()

grDevices::pdf(PDF_FILE,width=20,height=12,family="Helvetica")
par(mar=c(1,1,1,1),xpd=TRUE,family="sans")
plot_integrated_figure()
grDevices::dev.off()

grDevices::tiff(TIFF_FILE,width=10000,height=6000,res=600,compression="lzw")
par(mar=c(1,1,1,1),xpd=TRUE,family="sans")
plot_integrated_figure()
grDevices::dev.off()

