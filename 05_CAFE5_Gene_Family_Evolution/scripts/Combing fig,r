cat("\n============================================================\n")
cat("READING TREE\n")
cat("============================================================\n")

if (!file.exists(TREE_FILE)) {
  stop("TREE FILE NOT FOUND:\n", TREE_FILE)
}

tr <- read.tree(
  TREE_FILE
)

NTIP   <- Ntip(tr)
NNODE  <- tr$Nnode
NTOTAL <- NTIP + NNODE

cat("Tips:        ", NTIP, "\n", sep = "")
cat("Internal:    ", NNODE, "\n", sep = "")
cat("Total nodes: ", NTOTAL, "\n", sep = "")
cat("Rooted:      ", is.rooted(tr), "\n", sep = "")
cat("Binary:      ", is.binary(tr), "\n", sep = "")

if (NTIP != 36) {
  stop("Tree does not contain exactly 36 tips.")
}


# ================================================================================
# 12. TREE TIP NAMES
# ================================================================================

tree_names <- sub(
  "<[0-9]+>$",
  "",
  tr$tip.label
)

tree_names <- clean_genome(
  tree_names
)

tree_keys <- normalize_genome(
  tree_names
)

master_keys <- normalize_genome(
  master_order
)


# ================================================================================
# 13. CHECK MASTER / TREE MATCHING
# ================================================================================

missing_tree <- setdiff(
  master_keys,
  tree_keys
)

extra_tree <- setdiff(
  tree_keys,
  master_keys
)

if (length(missing_tree) > 0) {

  cat("\nMissing from tree:\n")

  print(missing_tree)

}

if (length(extra_tree) > 0) {

  cat("\nExtra tree names:\n")

  print(extra_tree)

}

if (
  length(missing_tree) > 0 ||
  length(extra_tree) > 0
) {

  stop(
    "Tree names and master_order do not match after normalization."
  )

}


