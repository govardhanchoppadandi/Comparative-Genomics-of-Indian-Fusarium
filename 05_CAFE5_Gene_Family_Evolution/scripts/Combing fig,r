# 28. TREE COORDINATES
# ================================================================================

cat("\n============================================================\n")
cat("CALCULATING TREE COORDINATES\n")
cat("============================================================\n")

tmp_pdf <- tempfile(
  fileext = ".pdf"
)

pdf(
  tmp_pdf,
  width = 10,
  height = 12
)

plot.phylo(
  tr,
  type = "phylogram",
  direction = "rightwards",
  use.edge.length = TRUE,
  show.tip.label = FALSE,
  show.node.label = FALSE,
  no.margin = TRUE
)

coord <- get(
  "last_plot.phylo",
  envir = ape:::.PlotPhyloEnv
)

dev.off()

unlink(
  tmp_pdf
)

xx <- coord$xx
yy <- coord$yy


# ================================================================================
# 29. NORMALIZE TREE Y
# ================================================================================

tree_tip_y <- yy[
  seq_len(NTIP)
]

raw_min <- min(tree_tip_y)
raw_max <- max(tree_tip_y)

tree_y_scaled <- numeric(
  NTOTAL
)

for (
  i in seq_len(
    NTOTAL
  )
) {

  tree_y_scaled[i] <-
    0.900 -
    (
      (
        yy[i] -
          raw_min
      ) /
        (
          raw_max -
            raw_min
        )
    ) *
      0.810

}


# ================================================================================
# 30. TREE X
# ================================================================================

xmin_tree <- min(xx)
xmax_tree <- max(xx)

xn <- (
  xx -
    xmin_tree
) /
  (
    xmax_tree -
      xmin_tree
  )

xn <- xn ^ 1.45

tree_x <-
  0.025 +
  xn * 0.235


# ================================================================================
# 31. MASTER TREE Y
# ================================================================================

master_tree_y <- numeric(
  length(master_order)
)

for (
  i in seq_along(
    master_order
  )
) {

  idx <- match(
    master_keys[i],
    tree_keys
  )

  master_tree_y[i] <-
    tree_y_scaled[idx]

}

N <- length(master_order)


# ================================================================================
# 32. CAFE FORMAT
# ================================================================================

format_change <- function(z) {

  paste0(
    "+",
    format(
      z$Increase,
      big.mark = ",",
      scientific = FALSE,
      trim = TRUE
    ),
    " / -",
    format(
      z$Decrease,
      big.mark = ",",
      scientific = FALSE,
      trim = TRUE
    )
  )

}


# ================================================================================
# 33. CAFE PIE
# ================================================================================

draw_pie <- function(
    x,
    y,
    expansion,
    contraction,
    radius = 0.009
) {

  total <-
    expansion +
    contraction

  if (
    !is.finite(total) ||
    total <= 0
  ) {

    return(
      invisible(NULL)
    )

  }

  prop <-
    expansion /
    total

  theta1 <- seq(
    0,
    2 * pi * prop,
    length.out = 80
  )

  polygon(
    c(
      x,
      x +
        radius *
        cos(theta1)
    ),
    c(
      y,
      y +
        radius *
        sin(theta1)
    ),
    col = EXPANSION,
    border = "white",
    lwd = 0.5
  )

  theta2 <- seq(
    2 * pi * prop,
    2 * pi,
    length.out = 80
  )

  polygon(
    c(
      x,
      x +
        radius *
        cos(theta2)
    ),
    c(
      y,
      y +
        radius *
        sin(theta2)
    ),
    col = CONTRACTION,
    border = "white",
    lwd = 0.5
  )

  theta3 <- seq(
    0,
    2 * pi,
    length.out = 80
  )

  lines(
    x +
      radius *
      cos(theta3),
    y +
      radius *
      sin(theta3),
    col = "white",
    lwd = 0.6
  )

}


# ================================================================================
# 34. FEATURE BAR
# ================================================================================

draw_feature_bar <- function(
    value,
    x_left,
    x_right,
    y,
    height,
    fill,
    max_value
) {

  rect(
    x_left,
    y - height / 2,
    x_right,
    y + height / 2,
    col = "#EEEEEE",
    border = NA
  )

  if (
    is.finite(value) &&
    value > 0 &&
    max_value > 0
  ) {

    value_x <-
      x_left +
      (
        value /
          max_value
      ) *
        (
          x_right -
            x_left
        )

    rect(
      x_left,
      y - height / 2,
      value_x,
      y + height / 2,
      col = fill,
      border = NA
    )

  }

}


# ================================================================================
# 35. STACKED BAR
# ================================================================================

draw_stacked_bar <- function(
    values,
    colors,
    x_left,
    x_right,
    y,
    height,
    max_total
) {

  rect(
    x_left,
    y - height / 2,
    x_right,
    y + height / 2,
    col = "#EEEEEE",
    border = NA
  )

  total <- sum(
    values,
    na.rm = TRUE
  )

  if (
    !is.finite(total) ||
    total <= 0 ||
    max_total <= 0
  ) {

    return(
      invisible(NULL)
    )

  }

  xpos <- x_left

  for (
    i in seq_along(values)
  ) {

    v <- values[i]

    if (
      !is.finite(v) ||
      v <= 0
    ) {
      next
    }

    xnext <-
      xpos +
      (
        v /
          max_total
      ) *
        (
          x_right -
            x_left
        )

    rect(
      xpos,
      y - height / 2,
      xnext,
      y + height / 2,
      col = colors[i],
      border = NA
    )

    xpos <- xnext

  }

}


# ================================================================================
# 36. AXIS TICKS
# ================================================================================

draw_ticks <- function(
    max_value,
    x_left,
    x_right,
    y_axis,
    percent = FALSE
) {

  if (
    !is.finite(max_value) ||
    max_value <= 0
  ) {
    return()
  }

  ticks <- pretty(
    c(
      0,
      max_value
    ),
    n = 3
  )

  ticks <-
    ticks[
      ticks >= 0 &
        ticks <= max_value
    ]

  for (
    v in ticks
  ) {

    xpos <-
      x_left +
      (
        v /
          max_value
      ) *
        (
          x_right -
            x_left
        )

    segments(
      xpos,
      y_axis,
      xpos,
      y_axis - 0.008,
      col = "#444444",
      lwd = 0.7
    )

    lab <-
      if (percent) {

        paste0(
          format(
            v,
            trim = TRUE
          ),
          "%"
        )

      } else {

        format(
          v,
          trim = TRUE,
          big.mark = ",",
          scientific = FALSE
        )

      }

    text(
      xpos,
      y_axis - 0.017,
      lab,
      cex = CE_AXIS,
      font = FONT_AXIS,
      col = TEXTCOL
    )

  }

}


# ================================================================================
# 37. PANEL POSITIONS
# ================================================================================

TREE_LEFT  <- 0.020
TREE_RIGHT <- 0.245

INTERNAL_VALUE_X <- 0.265

TIP_PIE_X   <- 0.300
TIP_VALUE_X <- 0.323

NAME_LEFT <- 0.365


# ----------------------------------------------------------------
# IMPORTANT:
# More room for genome names.
# Feature panels start later.
# ----------------------------------------------------------------

PANEL_START <- 0.535

PANEL_WIDTH <- 0.047

PANEL_GAP <- 0.008


P1 <- PANEL_START

P2 <- P1 + PANEL_WIDTH + PANEL_GAP

P3 <- P2 + PANEL_WIDTH + PANEL_GAP

P4 <- P3 + PANEL_WIDTH + PANEL_GAP

P5 <- P4 + PANEL_WIDTH + PANEL_GAP

P6 <- P5 + PANEL_WIDTH + PANEL_GAP

P7 <- P6 + PANEL_WIDTH + PANEL_GAP

P8 <- P7 + PANEL_WIDTH + PANEL_GAP


