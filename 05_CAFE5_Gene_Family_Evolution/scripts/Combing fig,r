# ================================================================================

max_genome <-
  max(
    dat$Genome_size_Mb,
    na.rm = TRUE
  ) * 1.10

max_te <-
  max(
    dat$TE,
    na.rm = TRUE
  ) * 1.10

max_rip <-
  max(
    dat$RIP,
    na.rm = TRUE
  ) * 1.10

max_lrar <-
  max(
    dat$LRAR,
    na.rm = TRUE
  ) * 1.10

max_overlap <-
  max(
    dat$TE_RIP_overlap,
    na.rm = TRUE
  ) * 1.10

max_bgc <-
  max(
    dat$Total_BGC,
    na.rm = TRUE
  ) * 1.10


anti_matrix <- dat[
  ,
  c(
    "NRPS",
    "PKS",
    "Hybrid",
    "Terpene",
    "Other_BGC"
  )
]

anti_max <-
  max(
    rowSums(
      anti_matrix,
      na.rm = TRUE
    ),
    na.rm = TRUE
  ) * 1.10


dbcan_matrix <- dat[
  ,
  c(
    "GH",
    "GT",
    "CE",
    "PL",
    "AA",
    "CBM"
  )
]

dbcan_max <-
  max(
    rowSums(
      dbcan_matrix,
      na.rm = TRUE
    ),
    na.rm = TRUE
  ) * 1.10


# ================================================================================
# 40. MAIN PLOT
# ================================================================================

plot_integrated_figure <- function() {

  plot(
    NA,
    NA,
    type = "n",
    xlim = c(
      0,
      1
    ),
    ylim = c(
      0,
      1
    ),
    axes = FALSE,
    xlab = "",
    ylab = ""
  )


  # ============================================================================
  # TREE HORIZONTAL BRANCHES
  # ============================================================================

  for (
    i in seq_len(
      nrow(
        tr$edge
      )
    )
  ) {

    parent <- tr$edge[i, 1]
    child  <- tr$edge[i, 2]

    segments(
      tree_x[parent],
      tree_y_scaled[child],
      tree_x[child],
      tree_y_scaled[child],
      col = TREECOL,
      lwd = 1.15
    )

  }


  # ============================================================================
  # TREE VERTICAL BRANCHES
  # ============================================================================

  parents <- unique(
    tr$edge[, 1]
  )

  for (
    p in parents
  ) {

    children <-
      tr$edge[
        tr$edge[, 1] == p,
        2
      ]

    if (
      length(children) >= 2
    ) {

      segments(
        tree_x[p],
        min(
          tree_y_scaled[
            children
          ]
        ),
        tree_x[p],
        max(
          tree_y_scaled[
            children
          ]
        ),
        col = TREECOL,
        lwd = 1.15
      )

    }

  }


  # ============================================================================
  # INTERNAL CAFE PIES
  # ============================================================================

  for (
    node in internal_nodes
  ) {

    z <- get_cafe(node)

    draw_pie(
      tree_x[node],
      tree_y_scaled[node],
      z$Increase,
      z$Decrease,
      radius = INTERNAL_RADIUS
    )

  }


  # ============================================================================
  # INTERNAL CAFE LEADER LINES + VALUES
  # ============================================================================

  for (
    i in seq_along(
      internal_nodes
    )
  ) {

    segments(
      internal_x[i] +
        INTERNAL_RADIUS,
      internal_y[i],
      label_x[i] -
        0.004,
      label_y[i],
      col = LEADERCOL,
      lwd = 0.45
    )

    z <- get_cafe(
      internal_nodes[i]
    )

    text(
      label_x[i],
      label_y[i],
      format_change(z),
      adj = c(
        0,
        0.5
      ),
      cex = CE_INTERNAL_VALUE,
      font = FONT_VALUE,
      col = TEXTCOL
    )

  }


  # ============================================================================
  # CAFE HEADER
  # ============================================================================

  text(
    TIP_PIE_X,
    0.952,
    "CAFE5",
    font = FONT_HEADER,
    cex = CE_HEADER,
    col = TEXTCOL
  )

  text(
    TIP_VALUE_X,
    0.952,
    "Expansion / Contraction",
    font = FONT_HEADER,
    cex = 0.52,
    adj = c(
      0,
      0.5
    ),
    col = TEXTCOL
  )


  # ============================================================================
  # GENOME HEADER
  # ============================================================================

  text(
    NAME_LEFT,
    0.952,
    "Fusarium genome",
    font = FONT_HEADER,
    cex = CE_HEADER,
    adj = c(
      0,
      0.5
    ),
    col = TEXTCOL
  )


  # ============================================================================
  # TIP CAFE + GENOME NAMES
  # ============================================================================

  for (
    i in seq_len(N)
  ) {

    tree_tip <-
      match(
        master_keys[i],
        tree_keys
      )

    z <- get_cafe(
      tree_tip
    )


    # --------------------------------------------------------------------------
    # TIP CAFE PIE
    # --------------------------------------------------------------------------

    if (!is.null(z)) {

      draw_pie(
        TIP_PIE_X,
        master_tree_y[i],
        z$Increase,
        z$Decrease,
        radius = 0.010
      )


      # ------------------------------------------------------------------------
      # TIP CAFE VALUE
      # ------------------------------------------------------------------------

      text(
        TIP_VALUE_X,
        master_tree_y[i],
        format_change(z),
        adj = c(
          0,
          0.5
        ),
        cex = CE_CAFE_VALUE,
        font = FONT_VALUE,
        col = TEXTCOL
      )

    }


    # --------------------------------------------------------------------------
    # GENOME NAME
    # --------------------------------------------------------------------------

    text(
      NAME_LEFT,
      master_tree_y[i],
      master_order[i],
      adj = c(
        0,
        0.5
      ),
      font = FONT_GENOME,
      cex = CE_GENOME,
      col = TEXTCOL
    )

  }


  # ============================================================================
  # PANEL TITLES
  # ============================================================================

  title_y <- 0.952

  panel_title <- function(
      x,
      title,
      cex = CE_PANEL_TITLE
  ) {

    text(
      x,
      title_y,
      title,
      font = FONT_HEADER,
      cex = cex,
      col = TEXTCOL
    )

  }


  panel_title(
    (P1 + R1) / 2,
    "Genome\nsize"
  )

  panel_title(
    (P2 + R2) / 2,
    "TE"
  )

  panel_title(
    (P3 + R3) / 2,
    "RIP"
  )

  panel_title(
    (P4 + R4) / 2,
    "LRAR"
  )

  panel_title(
    (P5 + R5) / 2,
    "TE–RIP"
  )

  panel_title(
    (P6 + R6) / 2,
    "BGC"
  )

  panel_title(
    (P7 + R7) / 2,
    "antiSMASH"
  )

  panel_title(
    (P8 + R8) / 2,
    "dbCAN3"
  )


  # ============================================================================
  # BAR HEIGHT
  # ============================================================================

  BAR_HEIGHT <- 0.011


  # ============================================================================
  # FEATURE BARS
  # ============================================================================

  for (
    i in seq_len(N)
  ) {

    y <- master_tree_y[i]


    # --------------------------------------------------------------------------
    # GENOME SIZE
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$Genome_size_Mb[i],
      P1,
      R1,
      y,
      BAR_HEIGHT,
      COL_GENOME,
      max_genome
    )


    # --------------------------------------------------------------------------
    # TE
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$TE[i],
      P2,
      R2,
      y,
      BAR_HEIGHT,
      COL_TE,
      max_te
    )


    # --------------------------------------------------------------------------
    # RIP
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$RIP[i],
      P3,
      R3,
      y,
      BAR_HEIGHT,
      COL_RIP,
      max_rip
    )


    # --------------------------------------------------------------------------
    # LRAR
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$LRAR[i],
      P4,
      R4,
      y,
      BAR_HEIGHT,
      COL_LRAR,
      max_lrar
    )


    # --------------------------------------------------------------------------
    # TE-RIP OVERLAP
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$TE_RIP_overlap[i],
      P5,
      R5,
      y,
      BAR_HEIGHT,
      COL_OVERLAP,
      max_overlap
    )


    # --------------------------------------------------------------------------
    # TOTAL BGC
    # --------------------------------------------------------------------------

    draw_feature_bar(
      dat$Total_BGC[i],
      P6,
      R6,
      y,
      BAR_HEIGHT,
      COL_BGC,
      max_bgc
    )


    # --------------------------------------------------------------------------
    # antiSMASH
    # --------------------------------------------------------------------------

    anti_values <- c(

      dat$NRPS[i],
      dat$PKS[i],
      dat$Hybrid[i],
      dat$Terpene[i],
      dat$Other_BGC[i]

    )

    draw_stacked_bar(
      anti_values,
      ANTISMASH_COLORS,
      P7,
      R7,
      y,
      BAR_HEIGHT,
      anti_max
    )


    # --------------------------------------------------------------------------
    # dbCAN3
    # --------------------------------------------------------------------------

    dbcan_values <- c(

      dat$GH[i],
      dat$GT[i],
      dat$CE[i],
      dat$PL[i],
      dat$AA[i],
      dat$CBM[i]

    )

    draw_stacked_bar(
      dbcan_values,
      DBCAN_COLORS,
      P8,
      R8,
      y,
      BAR_HEIGHT,
      dbcan_max
    )

  }


  # ============================================================================
  # AXES
  # ============================================================================

  axis_y <- 0.050

  draw_ticks(
    max_genome,
    P1,
    R1,
    axis_y,
    FALSE
  )

  draw_ticks(
    max_te,
    P2,
    R2,
    axis_y,
    TRUE
  )

  draw_ticks(
    max_rip,
    P3,
    R3,
    axis_y,
    TRUE
  )

  draw_ticks(
    max_lrar,
    P4,
    R4,
    axis_y,
    TRUE
  )

  draw_ticks(
    max_overlap,
    P5,
    R5,
    axis_y,
    TRUE
  )

  draw_ticks(
    max_bgc,
    P6,
    R6,
    axis_y,
    FALSE
  )

  draw_ticks(
    anti_max,
    P7,
    R7,
    axis_y,
    FALSE
  )

  draw_ticks(
    dbcan_max,
    P8,
    R8,
    axis_y,
    FALSE
  )


  # ============================================================================
  # CAFE LEGEND — TOP LEFT OF FIGURE
  # ============================================================================

  legend(
    "topleft",
    inset = c(
      0.005,
      0.005
    ),
    legend = c(
      "Expansion",
      "Contraction"
    ),
    pch = 15,
    col = c(
      EXPANSION,
      CONTRACTION
    ),
    pt.cex = 1.0,
    bty = "n",
    cex = CE_LEGEND,
    text.font = FONT_LEGEND,
    horiz = TRUE,
    x.intersp = 0.5
  )


  # ============================================================================
  # antiSMASH SHORT LEGEND
  # ============================================================================
  #
  # SEPARATE FROM dbCAN3
  # ============================================================================

  legend(
    "bottom",
    inset = c(
      0,
      -0.055
    ),
    legend = c(
      "NRPS",
      "PKS",
      "Hybrid",
      "TER",
      "Other"
    ),
    fill = ANTISMASH_COLORS,
    border = NA,
    bty = "n",
    horiz = TRUE,
    cex = CE_LEGEND,
    text.font = FONT_LEGEND,
    x.intersp = 0.40
  )


  # ============================================================================
  # dbCAN3 SHORT LEGEND
  # ============================================================================
  #
  # PLACED ABOVE ANOTHER LINE SO IT DOES NOT MIX WITH antiSMASH
  # ============================================================================

  legend(
    "bottom",
    inset = c(
      0,
      -0.092
    ),
    legend = c(
      "GH",
      "GT",
      "CE",
      "PL",
      "AA",
      "CBM"
    ),
    fill = DBCAN_COLORS,
    border = NA,
    bty = "n",
    horiz = TRUE,
    cex = CE_LEGEND,
    text.font = FONT_LEGEND,
    x.intersp = 0.35
  )


  # ============================================================================
  # FOOTNOTE
  # ============================================================================

  text(
    0.020,
    0.012,
    "CAFE5: gene-family expansion/contraction; bars: genome-level features; stacked bars: antiSMASH BGC and dbCAN3 CAZyme composition.",
    adj = c(
      0,
      0.5
    ),
    cex = CE_FOOT,
    font = FONT_FOOT,
    col = "#555555"
  )

}


