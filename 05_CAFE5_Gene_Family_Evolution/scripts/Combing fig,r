# ================================================================================
# 20. CHECK FOR DUPLICATE NORMALIZED KEYS
# ================================================================================

check_duplicates <- function(
    df,
    name
) {

  dup <- unique(
    df$Key[
      duplicated(df$Key)
    ]
  )

  if (length(dup) > 0) {

    stop(
      "\nDuplicate genome keys detected in ",
      name,
      ":\n",
      paste(
        dup,
        collapse = "\n"
      )
    )

  }

}

check_duplicates(
  te_clean,
  "TE/RIP"
)

check_duplicates(
  antismash_clean,
  "antiSMASH"
)

check_duplicates(
  dbcan_clean,
  "dbCAN3"
)


# ================================================================================
# 21. CREATE MASTER TABLE USING NORMALIZED KEYS
# ================================================================================
#
# IMPORTANT:
# DO NOT use merge() on the raw genome names.
#
# Everything is matched by Key.
# ================================================================================

dat <- data.frame(

  Genome = master_order,

  Key = master_keys,

  stringsAsFactors = FALSE

)


dat <- merge(
  dat,
  te_clean[
    ,
    c(
      "Key",
      "Genome_size_Mb",
      "TE",
      "RIP",
      "LRAR",
      "TE_RIP_overlap"
    )
  ],
  by = "Key",
  all.x = TRUE,
  sort = FALSE
)


dat <- merge(
  dat,
  antismash_clean[
    ,
    c(
      "Key",
      "Total_BGC",
      "NRPS",
      "PKS",
      "Hybrid",
      "Terpene",
      "Other_BGC"
    )
  ],
  by = "Key",
  all.x = TRUE,
  sort = FALSE
)


dat <- merge(
  dat,
  dbcan_clean[
    ,
    c(
      "Key",
      "GH",
      "GT",
      "CE",
      "PL",
      "AA",
      "CBM"
    )
  ],
  by = "Key",
  all.x = TRUE,
  sort = FALSE
)


# ================================================================================
# 22. FORCE EXACT ORDER
# ================================================================================

dat <- dat[
  match(
    master_keys,
    dat$Key
  ),
  ,
  drop = FALSE
]

dat$Genome <- master_order


# ================================================================================
# 23. CHECK TNW1 BEFORE ANY ZERO FILLING
# ================================================================================

tnw1_row <- which(
  dat$Key ==
    normalize_genome(
      "TNW1"
    )
)

if (length(tnw1_row) != 1) {

  stop(
    "TNW1 could not be matched correctly."
  )

}

cat("\n============================================================\n")
cat("TNW1 DATA CHECK\n")
cat("============================================================\n")

print(
  dat[
    tnw1_row,
    ,
    drop = FALSE
  ]
)


# ================================================================================
# 24. CHECK ALL 36 GENOMES
# ================================================================================

numeric_columns <- c(

  "Genome_size_Mb",
  "TE",
  "RIP",
  "LRAR",
  "TE_RIP_overlap",

  "Total_BGC",
  "NRPS",
  "PKS",
  "Hybrid",
  "Terpene",
  "Other_BGC",

  "GH",
  "GT",
  "CE",
  "PL",
  "AA",
  "CBM"

)

for (cc in numeric_columns) {

  dat[[cc]] <- suppressWarnings(
    as.numeric(
      dat[[cc]]
    )
  )

}


# ================================================================================
# 25. PRINT MATCH STATUS
# ================================================================================

cat("\n============================================================\n")
cat("DATA MATCH STATUS\n")
cat("============================================================\n")

for (i in seq_len(nrow(dat))) {

  status <- c(
    Genome_size = !is.na(dat$Genome_size_Mb[i]),
    TE          = !is.na(dat$TE[i]),
    RIP         = !is.na(dat$RIP[i]),
    LRAR        = !is.na(dat$LRAR[i]),
    Overlap     = !is.na(dat$TE_RIP_overlap[i]),
    antiSMASH   = !is.na(dat$Total_BGC[i]),
    dbCAN3      = !is.na(dat$GH[i])
  )

  if (!all(status)) {

    cat(
      "\nWARNING: ",
      dat$Genome[i],
      "\n",
      sep = ""
    )

    print(
      status
    )

  }

}


# ================================================================================
# 26. ONLY NOW REPLACE TRUE MISSING VALUES WITH ZERO
# ================================================================================
#
# This means a real matched TNW1 row is retained.
# ================================================================================

for (cc in numeric_columns) {

  dat[[cc]][
    !is.finite(
      dat[[cc]]
    )
  ] <- NA_real_

  dat[[cc]][
    is.na(
      dat[[cc]]
    )
  ] <- 0

}


# ================================================================================
# 27. SAVE FINAL DATA
# ================================================================================

write.csv(
  dat,
  DATA_FILE,
  row.names = FALSE
)


