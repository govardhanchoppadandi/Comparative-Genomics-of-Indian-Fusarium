# ================================================================================
# 8. ROBUST GENOME NORMALIZATION
# ================================================================================
#
# THIS IS THE IMPORTANT TNW1 FIX.
#
# Examples:
#
# TNW1
# TNW_1
# TNW1_proteins
# TNW_1_proteins
#
# all become:
#
# tnw1
#
# Therefore they will match correctly.
# ================================================================================

normalize_genome <- function(x) {

  x <- as.character(x)

  x <- trimws(x)

  x <- tolower(x)

  # remove common extensions
  x <- gsub(
    "\\.(fa|fasta|faa|fna|gz)$",
    "",
    x,
    ignore.case = TRUE
  )

  # remove protein suffix
  x <- gsub(
    "_proteins$",
    "",
    x,
    ignore.case = TRUE
  )

  x <- gsub(
    "_protein$",
    "",
    x,
    ignore.case = TRUE
  )

  # TNW1 / TNW_1 equivalence
  x <- gsub(
    "[^a-z0-9]",
    "",
    x
  )

  x

}


# ================================================================================
# 9. DISPLAY NAME CLEANER
# ================================================================================

clean_genome <- function(x) {

  x <- as.character(x)

  x <- trimws(x)

  x <- gsub(
    "\\s+",
    "",
    x
  )

  x

}


# ================================================================================
# 10. FIND COLUMN
# ================================================================================

find_column <- function(
    df,
    exact = NULL,
    patterns = NULL
) {

  nms <- names(df)

  if (!is.null(exact)) {

    hit <- exact[
      exact %in% nms
    ]

    if (length(hit) > 0) {
      return(hit[1])
    }

  }

  if (!is.null(patterns)) {

    for (p in patterns) {

      hit <- grep(
        p,
        nms,
        ignore.case = TRUE,
        value = TRUE
      )

      if (length(hit) > 0) {
        return(hit[1])
      }

    }

  }

  NULL

}


