  stop("CAFE5 FILE NOT FOUND:\n", CAFE_FILE)
}

cafe <- read.delim(
  CAFE_FILE,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  comment.char = ""
)

colnames(cafe) <- trimws(
  colnames(cafe)
)

colnames(cafe)[1] <- "Taxon_ID"

required_cafe <- c(
  "Taxon_ID",
  "Increase",
  "Decrease"
)

if (
  !all(
    required_cafe %in%
      colnames(cafe)
  )
) {

  stop(
    "Required CAFE columns are missing.\nAvailable columns:\n",
    paste(
      colnames(cafe),
      collapse = "\n"
    )
  )

}


# ================================================================================
# 15. CAFE IDs
# ================================================================================

cafe$CAFE_ID <- suppressWarnings(
  as.integer(
    sub(
      ".*<([0-9]+)>.*",
      "\\1",
      cafe$Taxon_ID
    )
  )
)

direct_id <- suppressWarnings(
  as.integer(
    as.character(
      cafe$Taxon_ID
    )
  )
)

missing_id <- is.na(
  cafe$CAFE_ID
) &
  !is.na(
    direct_id
  )

if (any(missing_id)) {

  cafe$CAFE_ID[
    missing_id
  ] <- direct_id[
    missing_id
  ]

}

cafe$Increase <- suppressWarnings(
  as.numeric(
    cafe$Increase
  )
)

cafe$Decrease <- suppressWarnings(
  as.numeric(
    cafe$Decrease
  )
)

if (any(is.na(cafe$CAFE_ID))) {
  stop("NA CAFE IDs detected.")
}

if (any(is.na(cafe$Increase))) {
  stop("NA CAFE Increase values detected.")
}

if (any(is.na(cafe$Decrease))) {
  stop("NA CAFE Decrease values detected.")
}


# ================================================================================
# 16. CAFE MAP
# ================================================================================

cafe_map <- vector(
  "list",
  NTOTAL
)

for (
  i in seq_len(
    nrow(cafe)
  )
) {

  id <- cafe$CAFE_ID[i]

  if (
    id < 1 ||
    id > NTOTAL
  ) {

    stop(
      "CAFE ID outside tree: ",
      id
    )

  }

  cafe_map[[id]] <-
    cafe[
      i,
      ,
      drop = FALSE
    ]

}

get_cafe <- function(node) {

  cafe_map[[node]]

}


